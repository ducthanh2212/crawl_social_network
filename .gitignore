# Dependencies
node_modules/
package-lock.json.bak

# Production Build
dist/

# Environment Variables (Bao mat tuyet doi - khong push len git)
.env
.env.local
.env.*.local

# Facebook Sessions & Cookies (Thong tin dang nhap ca nhan)
data/sessions/*
