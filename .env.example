# =========================================================================
# CONFIGURATION CHO FACEBOOK KOL BRAND SAFETY AI CRAWLER
# =========================================================================

# 1. Google Gemini API Key (Bắt buộc để LLM bóc tách phốt & tính điểm Brand Safety)
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# 2. Cấu hình Trình duyệt Playwright (true = chạy ngầm không hiện cửa sổ; false = hiện cửa sổ duyệt web)
HEADLESS=true

# 3. Cấu hình Proxy (Để trống nếu không dùng)
# Định dạng: http://username:password@ip:port hoặc http://ip:port
PROXY_URL=""

# 4. Mức độ ghi log (debug, info, warn, error)
LOG_LEVEL="info"
